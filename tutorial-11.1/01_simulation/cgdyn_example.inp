[INPUT]
grotopfile          = protein.top
grocrdfile          = protein.gro

[OUTPUT]
dcdfile             = protein_md1.dcd
rstfile             = protein_md1.rst

[ENERGY]
forcefield          = RESIDCG
electrostatic       = CUTOFF
cg_IDR_HPS_epsilon  = 0.2
cg_cutoffdist_126   = 20.0
cg_cutoffdist_ele   = 35.0
cg_pairlistdist_126 = 23.0
cg_pairlistdist_ele = 38.0

[DYNAMICS]
integrator          = VVER
nsteps              = 100000
timestep            = 0.010
rstout_period       = 100000
crdout_period       = 10000
eneout_period       = 100
nbupdate_period     = 20
stoptr_period       = 20

[CONSTRAINTS]
rigid_bond          = NO

[ENSEMBLE]
ensemble            = NVT
tpcontrol           = LANGEVIN
temperature         = 300
gamma_t             = 0.01

[BOUNDARY]
type                = PBC
box_size_x          = 1000.0
box_size_y          = 1000.0
box_size_z          = 2200.0
domain_x            = 2
domain_y            = 2
domain_z            = 4


